<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>小费计算器</title>
  <style>
    :root {
      --bg: #f3f5f9;
      --card: #ffffff;
      --text: #1f2937;
      --muted: #6b7280;
      --border: #d1d5db;
      --accent: #2563eb;
      --accent-text: #ffffff;
      --result-bg: #eff6ff;
      --error: #dc2626;
    }
    [data-theme="dark"] {
      --bg: #0f172a;
      --card: #1e293b;
      --text: #e5e7eb;
      --muted: #94a3b8;
      --border: #334155;
      --accent: #3b82f6;
      --accent-text: #ffffff;
      --result-bg: #172554;
      --error: #f87171;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: system-ui, -apple-system, "Segoe UI", "Microsoft YaHei", sans-serif;
      background: var(--bg);
      color: var(--text);
      transition: background .2s, color .2s;
    }
    .card {
      width: min(420px, 92vw);
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, .08);
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }
    h1 { font-size: 1.4rem; margin: 0; }
    label {
      display: block;
      font-size: .9rem;
      color: var(--muted);
      margin: 14px 0 6px;
    }
    input[type="number"] {
      width: 100%;
      padding: 10px 12px;
      font-size: 1rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: transparent;
      color: var(--text);
    }
    input:focus { outline: 2px solid var(--accent); border-color: transparent; }
    .tips {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
    }
    .tips button, #theme-toggle, #reset {
      padding: 10px 0;
      font-size: .95rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: transparent;
      color: var(--text);
      cursor: pointer;
    }
    .tips button.active {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--accent-text);
    }
    #theme-toggle { padding: 6px 12px; }
    .error { color: var(--error); font-size: .85rem; min-height: 1.2em; margin-top: 4px; }
    .result {
      margin-top: 20px;
      padding: 16px;
      border-radius: 12px;
      background: var(--result-bg);
    }
    .row {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
    }
    .row strong { font-size: 1.15rem; }
    #reset { width: 100%; margin-top: 16px; }
  </style>
</head>
<body>
  <main class="card">
    <header>
      <h1>💰 小费计算器</h1>
      <button id="theme-toggle" type="button" aria-label="切换深色模式">🌙 深色</button>
    </header>

    <label for="bill">账单金额（元）</label>
    <input id="bill" type="number" min="0" step="0.01" placeholder="例如 268.50" />

    <label>小费比例</label>
    <div class="tips" id="tips">
      <button type="button" data-tip="10">10%</button>
      <button type="button" data-tip="15" class="active">15%</button>
      <button type="button" data-tip="18">18%</button>
      <button type="button" data-tip="20">20%</button>
    </div>
    <label for="custom-tip">自定义比例（%，填写后覆盖上面的选择）</label>
    <input id="custom-tip" type="number" min="0" max="100" step="0.5" placeholder="例如 12" />

    <label for="people">人数</label>
    <input id="people" type="number" min="1" step="1" value="1" />
    <div class="error" id="error"></div>

    <section class="result" aria-live="polite">
      <div class="row"><span>小费</span><strong id="tip-amount">¥0.00</strong></div>
      <div class="row"><span>总计</span><strong id="total">¥0.00</strong></div>
      <div class="row"><span>每人应付</span><strong id="per-person">¥0.00</strong></div>
    </section>

    <button id="reset" type="button">重置</button>
  </main>

  <script>
    const $ = (id) => document.getElementById(id);
    const billInput = $("bill");
    const customTipInput = $("custom-tip");
    const peopleInput = $("people");
    const tipButtons = document.querySelectorAll("#tips button");
    let selectedTip = 15;

    const fmt = (n) => "¥" + n.toFixed(2);

    function calculate() {
      const bill = parseFloat(billInput.value) || 0;
      const custom = parseFloat(customTipInput.value);
      const tipPct = Number.isFinite(custom) && custom >= 0 ? custom : selectedTip;
      const people = parseInt(peopleInput.value, 10);

      $("error").textContent = "";
      if (bill < 0) {
        $("error").textContent = "账单金额不能为负数";
        return render(0, 0, 0);
      }
      if (!Number.isInteger(people) || people < 1) {
        $("error").textContent = "人数至少为 1";
        return render(0, 0, 0);
      }

      const tip = bill * tipPct / 100;
      const total = bill + tip;
      render(tip, total, total / people);
    }

    function render(tip, total, perPerson) {
      $("tip-amount").textContent = fmt(tip);
      $("total").textContent = fmt(total);
      $("per-person").textContent = fmt(perPerson);
    }

    tipButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        tipButtons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        selectedTip = Number(btn.dataset.tip);
        customTipInput.value = "";
        calculate();
      });
    });

    customTipInput.addEventListener("input", () => {
      const hasCustom = customTipInput.value !== "";
      tipButtons.forEach((b) =>
        b.classList.toggle("active", !hasCustom && Number(b.dataset.tip) === selectedTip)
      );
      calculate();
    });

    [billInput, peopleInput].forEach((el) => el.addEventListener("input", calculate));

    $("reset").addEventListener("click", () => {
      billInput.value = "";
      customTipInput.value = "";
      peopleInput.value = 1;
      selectedTip = 15;
      tipButtons.forEach((b) => b.classList.toggle("active", b.dataset.tip === "15"));
      calculate();
    });

    function applyTheme(theme) {
      document.documentElement.dataset.theme = theme;
      $("theme-toggle").textContent = theme === "dark" ? "☀️ 浅色" : "🌙 深色";
      localStorage.setItem("tip-theme", theme);
    }
    $("theme-toggle").addEventListener("click", () => {
      applyTheme(document.documentElement.dataset.theme === "dark" ? "light" : "dark");
    });
    applyTheme(localStorage.getItem("tip-theme") ||
      (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"));

    calculate();
  </script>
</body>
</html>
